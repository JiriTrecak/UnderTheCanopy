{
  "root": {
    "class": "scrim gm-scrim",
    "children": [
      {
        "class": "gm",
        "children": [
          { "id": "title", "kind": "label", "class": "gm-title", "text": "@ui.game-menu.skirmish-menu" },
          { "id": "sub", "kind": "label", "class": "gm-sub" },
          {
            "id": "main", "class": "gm-page",
            "children": [
              { "id": "resume", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.resume", "action": "gm.resume" },
              { "id": "save", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.save-game", "action": "gm.save" },
              { "id": "load", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.load-game", "action": "gm.load" },
              { "id": "restart", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.restart-scenario", "action": "gm.restart" },
              { "id": "settings", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.settings", "action": "gm.settings" },
              { "id": "feedback", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.submit-feedback", "action": "gm.feedback" },
              { "id": "surrender", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.surrender", "action": "gm.surrender" },
              { "id": "exit", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.exit-to-menu", "action": "gm.exit" }
            ]
          },
          {
            "id": "save-page", "class": "gm-page", "visible": false,
            "children": [
              { "kind": "label", "class": "mp-caption", "text": "@ui.game-menu.save-name" },
              { "id": "name", "kind": "text_field", "class": "mp-field", "max_length": 100, "action": "gm.save-name" },
              {
                "class": "gm-row",
                "children": [
                  { "kind": "button", "class": "gm-button st-grow", "text": "@ui.game-menu.save", "action": "gm.save-confirm" },
                  { "kind": "button", "class": "gm-button st-grow", "text": "@ui.game-menu.back", "action": "gm.page-back" }
                ]
              }
            ]
          },
          {
            "id": "exit-page", "class": "gm-page", "visible": false,
            "children": [
              { "id": "save-exit", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.save-and-exit", "action": "gm.save-exit" },
              { "id": "leave", "kind": "button", "class": "gm-button", "text": "@ui.game-menu.exit-without-saving", "action": "gm.leave" },
              { "kind": "button", "class": "gm-button", "text": "@ui.game-menu.cancel", "action": "gm.page-back" }
            ]
          },
          {
            "id": "restart-page", "class": "gm-page", "visible": false,
            "children": [
              { "kind": "button", "class": "gm-button", "text": "@ui.game-menu.save-and-restart", "action": "gm.save-restart" },
              { "kind": "button", "class": "gm-button", "text": "@ui.game-menu.restart-without-saving", "action": "gm.restart-now" },
              { "kind": "button", "class": "gm-button", "text": "@ui.game-menu.cancel", "action": "gm.page-back" }
            ]
          },
          {
            "id": "surrender-page", "class": "gm-page", "visible": false,
            "children": [
              { "kind": "button", "class": "gm-button", "text": "@ui.game-menu.surrender", "action": "gm.surrender-now" },
              { "kind": "button", "class": "gm-button", "text": "@ui.game-menu.cancel", "action": "gm.page-back" }
            ]
          },
          { "id": "status", "kind": "label", "class": "gm-status" }
        ]
      }
    ]
  }
}
