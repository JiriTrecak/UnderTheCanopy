{
  "templates": {
    "sv-row": {
      "class": "sv-row",
      "children": [
        {
          "class": "sv-text",
          "children": [
            { "id": "name", "kind": "label", "class": "sv-name" },
            { "id": "meta", "kind": "label", "class": "sv-meta" }
          ]
        },
        { "id": "load", "kind": "button", "class": "gm-button gm-small", "text": "@ui.saves.load", "action": "saves.load" },
        { "id": "export", "kind": "button", "class": "gm-button gm-small", "text": "@ui.saves.export", "action": "saves.export", "tooltip": { "title": "@ui.saves.export", "body": "@ui.saves.export.tip" } },
        { "id": "delete", "kind": "button", "class": "gm-button gm-small", "text": "@ui.saves.delete", "action": "saves.delete" }
      ]
    }
  },
  "root": {
    "class": "scrim sv-scrim",
    "children": [
      {
        "class": "gm",
        "children": [
          { "kind": "label", "class": "gm-title", "text": "@ui.saves.load-game" },
          { "id": "list", "class": "sv-list", "repeat": "sv-row" },
          { "id": "empty", "kind": "label", "class": "gm-sub", "text": "@ui.saves.no-saves-yet" },
          { "id": "status", "kind": "label", "class": "gm-status" },
          { "kind": "button", "class": "gm-button", "text": "@ui.saves.import-save", "action": "saves.import", "tooltip": { "title": "@ui.saves.import-save-2", "body": "@ui.saves.import-save.tip" } },
          { "kind": "button", "class": "gm-button", "text": "@ui.saves.back", "action": "saves.back" }
        ]
      }
    ]
  }
}
