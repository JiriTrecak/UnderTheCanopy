{
  "templates": {
    "mh-line": { "kind": "label", "class": "mh-line" },
    "mh-active": {
      "class": "mh-active",
      "children": [
        { "id": "bullet", "class": "mh-bullet" },
        {
          "id": "copy", "class": "mh-active-copy",
          "children": [
            { "id": "title", "kind": "label", "class": "mh-title" },
            { "id": "description", "kind": "label", "class": "mh-description" }
          ]
        }
      ]
    }
  },
  "root": {
    "class": "mh",
    "children": [
      { "id": "fade", "class": "mh-fade", "visible": false },
      {
        "id": "top-bar", "class": "mh-bar mh-bar-top", "style": { "top": "0" }, "visible": false,
        "children": [
          { "id": "skip", "kind": "label", "class": "mh-skip", "text": "Esc  Skip", "visible": false }
        ]
      },
      {
        "id": "bottom-bar", "class": "mh-bar mh-bar-bottom", "style": { "bottom": "0" }, "visible": false,
        "children": [
          {
            "id": "transmission", "class": "mh-transmission", "visible": false,
            "children": [
              {
                "class": "mh-tx-frame",
                "children": [ { "id": "portrait", "kind": "image", "class": "mh-tx-portrait" } ]
              },
              {
                "class": "mh-tx-copy",
                "children": [
                  { "id": "speaker", "kind": "label", "class": "mh-tx-speaker" },
                  { "id": "text", "kind": "label", "class": "mh-tx-text" }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "objectives", "class": "mh-objectives",
        "children": [
          { "id": "caption", "kind": "label", "class": "mh-caption", "text": "Objectives" },
          { "id": "objective", "kind": "label", "class": "mh-objective" },
          { "id": "active", "class": "mh-actives", "repeat": "mh-active" },
          {
            "id": "history", "class": "mh-history", "visible": false,
            "children": [
              { "id": "summary", "kind": "button", "class": "mh-summary", "action": "mission.history" },
              { "id": "lines", "class": "mh-lines", "repeat": "mh-line", "visible": false }
            ]
          }
        ]
      },
      {
        "id": "autoplay", "class": "mh-auto", "visible": false,
        "children": [
          {
            "class": "mh-auto-box",
            "children": [
              { "id": "label", "kind": "label", "class": "mh-auto-label", "text": "Autoplay 4×" },
              { "id": "step", "kind": "label", "class": "mh-auto-step" },
              {
                "id": "speeds", "class": "mh-auto-speeds",
                "children": [
                  { "id": "s1", "kind": "button", "class": "mh-auto-speed", "text": "1×", "action": "autoplay.speed1" },
                  { "id": "s2", "kind": "button", "class": "mh-auto-speed", "text": "2×", "action": "autoplay.speed2" },
                  { "id": "s4", "kind": "button", "class": "mh-auto-speed", "text": "4×", "action": "autoplay.speed4" },
                  { "id": "s8", "kind": "button", "class": "mh-auto-speed", "text": "8×", "action": "autoplay.speed8" }
                ]
              },
              { "id": "take", "kind": "button", "class": "mh-auto-take", "text": "Take over", "action": "autoplay.take" }
            ]
          }
        ]
      },
      {
        "id": "dialogue-wrap", "class": "mh-dialogue-wrap", "visible": false,
        "children": [
          {
            "class": "mh-dialogue",
            "children": [
              { "id": "portrait", "kind": "image", "class": "mh-portrait" },
              {
                "class": "mh-copy",
                "children": [
                  { "id": "speaker", "kind": "label", "class": "mh-speaker" },
                  { "id": "text", "kind": "label", "class": "mh-text" }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
