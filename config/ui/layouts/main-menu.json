{
  "templates": {
    "mm-glow": { "class": "mm-glow" },
    "mm-core": { "class": "mm-core" },
    "mm-ray": { "class": "mm-ray" },
    "mm-mote": { "class": "mm-mote" },
    "mm-flame": { "class": "mm-flame" },
    "mm-ember": { "class": "mm-ember" }
  },
  "root": {
    "class": "mm",
    "children": [
      { "id": "art", "kind": "image", "class": "cover", "image": "menu-welcome" },
      {
        "id": "effects", "class": "mm-layer",
        "children": [
          { "id": "rays", "class": "mm-layer", "repeat": "mm-ray", "count": 5 },
          { "id": "glows", "class": "mm-layer", "repeat": "mm-glow", "count": 3 },
          { "id": "cores", "class": "mm-layer", "repeat": "mm-core", "count": 3 },
          { "id": "flames", "class": "mm-layer", "repeat": "mm-flame", "count": 15 },
          { "id": "embers", "class": "mm-layer", "repeat": "mm-ember", "count": 24 },
          { "id": "motes", "class": "mm-layer", "repeat": "mm-mote", "count": 24 }
        ]
      },
      {
        "class": "mm-rig",
        "children": [
          { "kind": "image", "class": "menu-logo", "image": "menu-logo" },
          {
            "class": "menu-actions mm-actions",
            "children": [
              { "id": "campaign", "kind": "button", "class": "menu-action mm-action", "text": "@ui.main-menu.campaign", "action": "menu.campaign" },
              { "id": "skirmish", "kind": "button", "class": "menu-action mm-action", "text": "@ui.main-menu.skirmish", "action": "menu.skirmish" },
              { "id": "multiplayer", "kind": "button", "class": "menu-action mm-action", "text": "@ui.main-menu.multiplayer", "action": "menu.multiplayer" },
              { "id": "load", "kind": "button", "class": "menu-action mm-action", "text": "@ui.main-menu.load-game", "action": "menu.load" },
              { "id": "editor", "kind": "button", "class": "menu-action mm-action", "text": "@ui.main-menu.editor", "action": "menu.editor" },
              { "id": "settings", "kind": "button", "class": "menu-action mm-action", "text": "@ui.main-menu.settings", "action": "menu.settings" },
              { "id": "feedback", "kind": "button", "class": "menu-action mm-action", "text": "@ui.main-menu.submit-feedback", "action": "menu.feedback" },
              { "id": "exit", "kind": "button", "class": "menu-action mm-action", "text": "@ui.main-menu.exit", "action": "menu.exit" }
            ]
          }
        ]
      },
      {
        "id": "release", "class": "mm-release",
        "children": [
          {
            "id": "version", "kind": "button", "class": "mm-release-button mm-release-version", "action": "releases.updates",
            "children": [
              { "id": "number", "kind": "label", "class": "mm-release-number" },
              { "id": "status", "kind": "label", "class": "mm-release-status" }
            ]
          },
          { "id": "notes", "kind": "button", "class": "mm-release-button", "text": "@ui.main-menu.what-s-new", "action": "releases.notes" }
        ]
      }
    ]
  }
}
