{
  "templates": {
    "cs-entry": {
      "class": "cs-entry",
      "children": [
        {
          "id": "heading", "class": "cs-heading",
          "children": [
            { "id": "label", "kind": "label", "class": "cs-heading-label" },
            { "class": "cs-heading-rule" }
          ]
        },
        {
          "id": "row", "class": "cs-row",
          "children": [
            { "id": "kind", "kind": "label", "class": "cs-row-kind" },
            { "id": "title", "kind": "label", "class": "cs-row-title" },
            { "id": "ai", "kind": "button", "class": "cs-act cs-ai", "text": "@ui.campaign-steps.play-with-ai", "action": "steps.autoplay", "visible": false },
            { "id": "act", "kind": "button", "class": "cs-act", "text": "@ui.campaign-steps.play", "action": "steps.act" }
          ]
        },
        {
          "id": "next", "class": "cs-next",
          "children": [
            { "id": "art", "kind": "image", "class": "cs-next-art" },
            {
              "class": "cs-next-body",
              "children": [
                { "id": "eyebrow", "kind": "label", "class": "cs-next-eyebrow" },
                { "id": "title", "kind": "label", "class": "cs-next-title" },
                { "id": "line", "kind": "label", "class": "cs-next-line" }
              ]
            },
            { "id": "ai", "kind": "button", "class": "cs-act cs-ai", "text": "@ui.campaign-steps.play-with-ai", "action": "steps.autoplay", "visible": false },
            { "id": "act", "kind": "button", "class": "cs-act cs-next-act", "text": "@ui.campaign-steps.play", "action": "steps.act" }
          ]
        }
      ]
    }
  },
  "root": {
    "class": "cs",
    "children": [
      { "id": "art", "kind": "image", "class": "cover", "image": "menu-aftermath" },
      { "class": "cs-veil" },
      { "class": "cs-shade-solid" },
      { "class": "cs-shade" },
      { "class": "cs-bottom" },
      {
        "class": "cs-content",
        "children": [
          { "id": "kicker", "kind": "label", "class": "cs-kicker", "text": "@ui.campaign-steps.the-campaign" },
          { "id": "title", "kind": "label", "class": "cs-title", "text": "@ui.campaign-steps.campaign" },
          { "class": "cs-title-rule" },
          { "id": "steps", "class": "cs-steps", "repeat": "cs-entry" },
          { "id": "complete", "kind": "label", "class": "cs-complete", "text": "@ui.campaign-steps.the-campaign-is-complete-any", "visible": false },
          {
            "class": "cs-footer",
            "children": [
              {
                "class": "cs-footer-left",
                "children": [
                  { "kind": "button", "class": "menu-action cs-back", "text": "@ui.campaign-steps.back", "action": "steps.back" },
                  { "id": "reset", "kind": "button", "class": "menu-action cs-reset", "text": "@ui.campaign-steps.reset", "action": "steps.reset", "visible": false }
                ]
              },
              { "id": "continue", "kind": "button", "class": "cs-continue", "text": "@ui.campaign-steps.continue", "action": "steps.continue" }
            ]
          }
        ]
      }
    ]
  }
}
