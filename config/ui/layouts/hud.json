{
  "visible": false,
  "root": {
    "class": "hud",
    "children": [
      {
        "id": "heroes",
        "class": "hero-bar",
        "repeat": "hero"
      },
      { "id": "hint", "kind": "label", "class": "hint", "visible": false },
      { "id": "outcome", "kind": "label", "class": "outcome", "visible": false },
      { "id": "error", "kind": "label", "class": "error" },
      {
        "id": "dock",
        "class": "dock",
        "children": [
          { "id": "groups", "class": "control-groups", "repeat": "group-button", "count": 10 },
          {
            "class": "map-frame",
            "children": [{ "id": "minimap", "kind": "image", "class": "minimap", "drag": true, "action": "minimap" }]
          },
          {
            "id": "selection",
            "class": "selection",
            "children": [
              { "id": "portrait", "kind": "image", "class": "portrait" },
              { "id": "experience", "kind": "sweep", "class": "experience" },
              { "id": "level", "kind": "label", "class": "level" },
              {
                "id": "copy",
                "class": "selection-copy",
                "children": [
                  { "id": "name", "kind": "label", "class": "selection-name" },
                  { "id": "stats", "class": "stats", "repeat": "stat" },
                  {
                    "id": "task", "class": "task", "visible": false,
                    "children": [
                      {
                        "id": "icon", "kind": "button", "class": "slot task-icon", "action": "task",
                        "children": [{ "id": "image", "kind": "image", "class": "slot-icon" }, { "class": "slot-rim" }]
                      },
                      {
                        "id": "meter", "kind": "bar", "class": "task-meter",
                        "children": [{ "id": "label", "kind": "label", "class": "task-label" }]
                      }
                    ]
                  },
                  { "id": "status", "kind": "label", "class": "workplace-status", "visible": false },
                  {
                    "class": "vitals",
                    "children": [
                      {
                        "id": "health", "kind": "bar", "class": "vital health",
                        "children": [{ "id": "value", "kind": "label", "class": "vital-value" }]
                      },
                      {
                        "id": "mana", "kind": "bar", "class": "vital mana",
                        "children": [{ "id": "value", "kind": "label", "class": "vital-value" }]
                      }
                    ]
                  }
                ]
              },
              { "id": "cards", "class": "unit-cards", "repeat": "unit-card" },
              { "id": "inventory", "class": "inventory", "repeat": "slot" },
              { "id": "queue", "class": "recruit-queue", "repeat": "queue-tile" },
              { "id": "orders", "class": "order-queue", "repeat": "order-tile" }
            ]
          },
          {
            "id": "actions",
            "class": "actions",
            "children": [
              { "id": "commands", "class": "command-grid", "repeat": "command", "count": 12 },
              { "id": "banners", "class": "banners", "repeat": "banner" },
              {
                "id": "pager", "class": "pager", "visible": false,
                "children": [
                  { "id": "prev", "kind": "button", "class": "pager-button", "action": "page-prev", "children": [{ "kind": "label", "text": "‹" }] },
                  { "id": "label", "kind": "label", "class": "pager-label" },
                  { "id": "next", "kind": "button", "class": "pager-button", "action": "page-next", "children": [{ "kind": "label", "text": "›" }] }
                ]
              },
              { "id": "resources", "class": "resources", "repeat": "resource" }
            ]
          }
        ]
      },
      {
        "id": "chat",
        "class": "chat",
        "children": [
          { "id": "log", "class": "chat-log", "repeat": "chat-line" },
          { "id": "input", "kind": "text_field", "class": "field chat-input", "max_length": 300, "placeholder": "Say something…", "visible": false }
        ]
      },
      {
        "id": "observer", "class": "observer", "visible": false,
        "children": [
          {
            "class": "observer-header",
            "children": [
              { "kind": "label", "class": "observer-title", "text": "Colony overview" },
              { "kind": "label", "class": "observer-badge", "text": "Observer" }
            ]
          },
          { "id": "columns", "kind": "label", "class": "observer-columns" },
          { "id": "rows", "class": "observer-rows", "repeat": "observer-row" },
          { "id": "footer", "kind": "label", "class": "observer-footer" }
        ]
      },
      {
        "id": "menu", "kind": "button", "class": "menu-button", "action": "menu",
        "tooltip": { "title": "Menu", "hotkey": "F10", "body": "Open the game menu." },
        "children": [{ "kind": "label", "text": "Menu" }]
      }
    ]
  }
}
