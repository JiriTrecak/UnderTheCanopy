{
  "templates": {
    "unit-card": {
      "kind": "button", "class": "unit-card", "action": "unit-card",
      "children": [
        { "id": "icon", "kind": "image", "class": "unit-card-icon" },
        { "id": "health", "kind": "bar", "class": "unit-card-health", "value": 1 }
      ]
    },
    "queue-tile": {
      "kind": "button", "class": "slot queue-tile", "action": "queue",
      "children": [
        { "id": "icon", "kind": "image", "class": "slot-icon" },
        { "class": "slot-rim" }
      ]
    },
    "order-tile": {
      "class": "order-tile",
      "tooltip": { "title": "" },
      "children": [
        { "id": "icon", "kind": "image", "class": "slot-icon" },
        { "id": "number", "kind": "label", "class": "order-number" }
      ]
    },
    "status-badge": {
      "class": "status-badge",
      "tooltip": { "title": "" },
      "children": [{ "id": "icon", "kind": "image", "class": "status-icon" }]
    },
    "banner": {
      "kind": "button", "class": "banner", "action": "banner", "tooltip_anchor": "actions",
      "children": [
        { "id": "icon", "kind": "image", "class": "banner-icon" },
        { "id": "label", "kind": "label", "class": "banner-label" },
        { "id": "key", "kind": "label", "class": "banner-key" }
      ]
    },
    "group-button": {
      "class": "group-slot",
      "children": [
        {
          "id": "button", "kind": "button", "class": "group-button", "action": "group",
          "children": [
            { "id": "key", "kind": "label", "class": "group-key" },
            { "id": "count", "kind": "label", "class": "group-count" }
          ]
        }
      ]
    },
    "chat-line": { "kind": "label", "class": "chat-line" },
    "observer-head": { "kind": "label", "class": "observer-good" },
    "observer-good": {
      "class": "observer-good",
      "tooltip": { "title": "" },
      "children": [
        {
          "class": "observer-good-main",
          "children": [
            { "id": "icon", "kind": "image", "class": "observer-icon" },
            { "id": "amount", "kind": "label", "class": "observer-amount" }
          ]
        },
        { "id": "income", "kind": "label", "class": "observer-income" }
      ]
    },
    "observer-hero": {
      "class": "observer-hero",
      "tooltip": { "title": "" },
      "children": [
        { "id": "icon", "kind": "image", "class": "observer-hero-icon" },
        {
          "class": "observer-hero-text",
          "children": [
            { "id": "level", "kind": "label", "class": "observer-hero-level" },
            { "id": "status", "kind": "label", "class": "observer-hero-status" }
          ]
        }
      ]
    },
    "observer-row": {
      "class": "observer-row",
      "children": [
        { "id": "color", "kind": "bar", "class": "observer-color", "value": 1 },
        { "id": "player", "kind": "label", "class": "observer-player" },
        { "id": "goods", "class": "observer-goods", "repeat": "observer-good" },
        { "id": "units", "kind": "label", "class": "observer-count", "tooltip": { "title": "" } },
        { "id": "workers", "kind": "label", "class": "observer-count", "tooltip": { "title": "" } },
        {
          "id": "heroes", "class": "observer-heroes", "repeat": "observer-hero",
          "children": [{ "id": "none", "kind": "label", "class": "observer-none", "text": "—", "tooltip": { "title": "", "body": "@ui.play.text.tip" } }]
        }
      ]
    }
  }
}
