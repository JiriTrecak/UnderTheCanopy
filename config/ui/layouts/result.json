{
  "templates": {
    "rs-row": {
      "class": "rs-row",
      "children": [
        { "id": "swatch", "class": "rs-swatch" },
        { "id": "name", "kind": "label", "class": "rs-cell-name" },
        { "id": "result", "kind": "label", "class": "rs-cell" },
        { "id": "units", "kind": "label", "class": "rs-cell" },
        { "id": "buildings", "kind": "label", "class": "rs-cell" }
      ]
    }
  },
  "root": {
    "class": "scrim rs-scrim",
    "children": [
      {
        "class": "rs",
        "children": [
          { "id": "eyebrow", "kind": "label", "class": "rs-eyebrow", "text": "@ui.result.skirmish-match-complete" },
          { "id": "title", "kind": "label", "class": "rs-title", "text": "@ui.result.victory" },
          { "id": "line", "kind": "label", "class": "rs-line" },
          {
            "class": "rs-table",
            "children": [
              {
                "class": "rs-row rs-head",
                "children": [
                  { "class": "rs-swatch" },
                  { "kind": "label", "class": "rs-cell-name", "text": "@ui.result.player" },
                  { "kind": "label", "class": "rs-cell", "text": "@ui.result.result" },
                  { "kind": "label", "class": "rs-cell", "text": "@ui.result.units" },
                  { "kind": "label", "class": "rs-cell", "text": "@ui.result.buildings" }
                ]
              },
              { "id": "rows", "style": { "display": "flex", "flex-direction": "column", "gap": "5px" }, "repeat": "rs-row" }
            ]
          },
          { "id": "goods", "kind": "label", "class": "rs-goods" },
          { "id": "replay-status", "kind": "label", "class": "rs-saved", "visible": false },
          {
            "class": "rs-actions",
            "children": [
              { "id": "save-replay", "kind": "button", "class": "rs-button rs-ghost", "text": "@ui.result.save-replay", "action": "result.save-replay" },
              { "id": "watch", "kind": "button", "class": "rs-button rs-ghost", "text": "@ui.result.keep-watching", "action": "result.watch" },
              { "id": "retry", "kind": "button", "class": "rs-button rs-ghost", "text": "@ui.result.retry", "action": "result.retry", "visible": false },
              { "id": "leave", "kind": "button", "class": "rs-button", "text": "@ui.result.return-to-menu", "action": "result.leave" }
            ]
          }
        ]
      }
    ]
  }
}
