{
  "templates": {
    "st-key-row": {
      "class": "st-key-row",
      "children": [
        { "id": "group", "kind": "label", "class": "st-key-group" },
        {
          "class": "st-key-line",
          "children": [
            { "id": "name", "kind": "label", "class": "st-key-name" },
            { "id": "key", "kind": "button", "class": "st-key", "text": "@ui.settings.unbound", "action": "settings.key" },
            { "id": "clear", "kind": "button", "class": "st-clear", "text": "@ui.settings.clear", "action": "settings.key-clear" }
          ]
        }
      ]
    }
  },
  "root": {
    "class": "scrim st-scrim",
    "children": [
      {
        "class": "st",
        "children": [
          { "kind": "label", "class": "settings-title", "text": "@ui.settings.settings" },
          {
            "class": "st-tabs",
            "children": [
              { "id": "tab-graphics", "kind": "button", "class": "st-tab", "text": "@ui.settings.graphics", "action": "settings.tab", "checked": true },
              { "id": "tab-audio", "kind": "button", "class": "st-tab", "text": "@ui.settings.audio", "action": "settings.tab" },
              { "id": "tab-interface", "kind": "button", "class": "st-tab", "text": "@ui.settings.interface", "action": "settings.tab" },
              { "id": "tab-gameplay", "kind": "button", "class": "st-tab", "text": "@ui.settings.gameplay", "action": "settings.tab" },
              { "id": "tab-keys", "kind": "button", "class": "st-tab", "text": "@ui.settings.keyboard", "action": "settings.tab" },
              { "id": "tab-network", "kind": "button", "class": "st-tab", "text": "@ui.settings.multiplayer", "action": "settings.tab" }
            ]
          },
          {
            "id": "graphics", "class": "st-page",
            "children": [
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.graphics-quality" },
                  { "id": "preset", "kind": "dropdown", "class": "select", "action": "settings.preset", "options": ["@ui.settings.auto", "@ui.settings.low", "@ui.settings.medium", "@ui.settings.high", "@ui.settings.ultra", "@ui.settings.custom"] },
                  { "kind": "label", "class": "settings-note", "text": "@ui.settings.auto-picks-what-this-mac" }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.game-resolution" },
                  { "id": "resolution", "kind": "dropdown", "class": "select", "action": "settings.resolution", "options": ["@ui.settings.native"] },
                  { "kind": "label", "class": "settings-note", "text": "@ui.settings.the-battlefield-renders-at-most" }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.render-scale" },
                  {
                    "class": "st-inline",
                    "children": [
                      { "id": "render-scale", "kind": "slider", "class": "slider st-grow", "min": 50, "max": 100, "step": 5, "value": 100, "action": "settings.render-scale" },
                      { "id": "render-scale-value", "kind": "label", "class": "st-value", "text": "100%" }
                    ]
                  },
                  { "kind": "label", "class": "settings-note", "text": "@ui.settings.below-100-the-scene-renders" }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.volumetric-fog-light-shafts" },
                  { "id": "haze", "kind": "dropdown", "class": "select", "action": "settings.haze", "options": ["@ui.settings.off", "@ui.settings.low", "@ui.settings.medium", "@ui.settings.high"], "selected": 2 }
                ]
              },
              { "id": "shadows", "kind": "checkbox", "class": "check", "text": "@ui.settings.shadows", "checked": true, "action": "settings.shadows" },
              { "id": "contact", "kind": "checkbox", "class": "check", "text": "@ui.settings.contact-shading", "checked": true, "action": "settings.contact" },
              { "id": "bloom", "kind": "checkbox", "class": "check", "text": "@ui.settings.bloom", "checked": true, "action": "settings.bloom" },
              { "id": "vsync", "kind": "checkbox", "class": "check", "text": "@ui.settings.vertical-sync", "checked": true, "action": "settings.vsync" },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.display" },
                  { "id": "window", "kind": "dropdown", "class": "select", "action": "settings.window", "options": ["@ui.settings.windowed", "@ui.settings.borderless", "@ui.settings.exclusive"] }
                ]
              }
            ]
          },
          {
            "id": "audio", "class": "st-page", "visible": false,
            "children": [
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.master-volume" },
                  { "class": "st-inline", "children": [
                    { "id": "master", "kind": "slider", "class": "slider st-grow", "min": 0, "max": 100, "step": 1, "action": "settings.volume" },
                    { "id": "master-value", "kind": "label", "class": "st-value" } ] }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.spell-effect-volume" },
                  { "class": "st-inline", "children": [
                    { "id": "effects", "kind": "slider", "class": "slider st-grow", "min": 0, "max": 100, "step": 1, "action": "settings.volume" },
                    { "id": "effects-value", "kind": "label", "class": "st-value" } ] }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.interface-volume" },
                  { "class": "st-inline", "children": [
                    { "id": "interface", "kind": "slider", "class": "slider st-grow", "min": 0, "max": 100, "step": 1, "action": "settings.volume" },
                    { "id": "interface-value", "kind": "label", "class": "st-value" } ] }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.music-volume" },
                  { "class": "st-inline", "children": [
                    { "id": "music", "kind": "slider", "class": "slider st-grow", "min": 0, "max": 100, "step": 1, "action": "settings.volume" },
                    { "id": "music-value", "kind": "label", "class": "st-value" } ] }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.voice-volume" },
                  { "class": "st-inline", "children": [
                    { "id": "voice", "kind": "slider", "class": "slider st-grow", "min": 0, "max": 100, "step": 1, "action": "settings.volume" },
                    { "id": "voice-value", "kind": "label", "class": "st-value" } ] }
                ]
              },
              { "id": "mute", "kind": "checkbox", "class": "check", "text": "@ui.settings.mute-while-the-game-is", "action": "settings.mute" }
            ]
          },
          {
            "id": "interface", "class": "st-page", "visible": false,
            "children": [
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.player-name" },
                  { "id": "name", "kind": "text_field", "class": "field", "placeholder": "@ui.settings.player", "max_length": 32, "action": "settings.name" }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.hud-layout" },
                  { "id": "hud-layout", "kind": "dropdown", "class": "select", "action": "settings.hud-layout", "options": ["@ui.settings.spread-screen-edges", "@ui.settings.compact-centered"], "selected": 0 }
                ]
              },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.hud-size" },
                  { "class": "st-inline", "children": [
                    { "id": "hud-scale", "kind": "slider", "class": "slider st-grow", "min": 30, "max": 100, "step": 1, "action": "settings.hud-scale" },
                    { "id": "hud-scale-value", "kind": "label", "class": "st-value" } ] },
                  { "kind": "label", "class": "settings-note", "text": "@ui.settings.30-100-resizes-the-minimap" }
                ]
              },
              { "id": "health-bars", "kind": "checkbox", "class": "check", "text": "@ui.settings.always-show-health-bars", "action": "settings.health-bars" },
              { "id": "tooltips", "kind": "checkbox", "class": "check", "text": "@ui.settings.show-tooltips", "action": "settings.tooltips" }
            ]
          },
          {
            "id": "gameplay", "class": "st-page", "visible": false,
            "children": [
              { "id": "delivery-text", "kind": "checkbox", "class": "check", "text": "@ui.settings.show-resource-deliveries", "action": "settings.delivery-text" },
              { "kind": "label", "class": "settings-note", "text": "@ui.settings.amber-your-workers-bring-in" }
            ]
          },
          {
            "id": "keys", "class": "st-page", "visible": false, "style": { "overflow": "hidden" },
            "children": [
              { "kind": "label", "class": "settings-note", "text": "@ui.settings.click-a-shortcut-then-press" },
              { "id": "search", "kind": "text_field", "class": "field", "placeholder": "@ui.settings.find-a-shortcut", "max_length": 60, "action": "settings.key-search" },
              { "id": "list", "class": "st-keys", "repeat": "st-key-row" },
              { "id": "message", "kind": "label", "class": "st-message" },
              { "kind": "button", "class": "settings-button", "text": "@ui.settings.restore-all-default-shortcuts", "action": "settings.keys-defaults" }
            ]
          },
          {
            "id": "network", "class": "st-page", "visible": false,
            "children": [
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.match-server" },
                  { "id": "server", "kind": "text_field", "class": "field", "placeholder": "18.134.138.1", "max_length": 200, "action": "settings.server" },
                  { "id": "server-note", "kind": "label", "class": "settings-note" }
                ]
              },
              { "kind": "button", "class": "settings-button", "text": "@ui.settings.use-the-default-server", "action": "settings.server-default" },
              {
                "class": "settings-row",
                "children": [
                  { "kind": "label", "class": "settings-label", "text": "@ui.settings.player-id" },
                  { "id": "player-id", "kind": "text_field", "class": "field", "placeholder": "Jiri1", "max_length": 32, "action": "settings.player-id" },
                  { "kind": "label", "class": "settings-note", "text": "@ui.settings.player-id-note" }
                ]
              }
            ]
          },
          {
            "class": "st-footer",
            "children": [
              { "id": "status", "kind": "label", "class": "settings-note st-grow", "text": "@ui.settings.saved-on-this-device-and" },
              { "kind": "button", "class": "settings-button", "text": "@ui.settings.done", "action": "settings.done" }
            ]
          }
        ]
      }
    ]
  }
}
