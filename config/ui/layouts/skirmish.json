{
  "templates": {
    "sk-map": {
      "kind": "button", "class": "sk-map", "action": "skirmish.map",
      "children": [
        { "id": "thumb", "kind": "image", "class": "sk-thumb" },
        {
          "class": "sk-map-text",
          "children": [
            { "id": "name", "kind": "label", "class": "sk-map-name" },
            { "id": "meta", "kind": "label", "class": "sk-map-meta" }
          ]
        }
      ]
    },
    "sk-marker": { "kind": "label", "class": "sk-marker" },
    "sk-player": {
      "class": "sk-player",
      "children": [
        {
          "class": "sk-player-head",
          "children": [
            { "id": "badge", "kind": "label", "class": "sk-badge" },
            {
              "class": "sk-player-text",
              "children": [
                { "id": "name", "kind": "label", "class": "sk-player-name" },
                { "id": "sub", "kind": "label", "class": "sk-player-sub" }
              ]
            }
          ]
        },
        {
          "class": "sk-selects",
          "children": [
            { "id": "controller", "kind": "dropdown", "class": "sk-select", "action": "skirmish.controller", "options": ["@ui.skirmish.human", "@ui.skirmish.ai"] },
            { "id": "team", "kind": "dropdown", "class": "sk-select", "action": "skirmish.team", "options": ["@ui.skirmish.no-team"] },
            { "id": "race", "kind": "dropdown", "class": "sk-select", "action": "skirmish.race", "options": [] },
            { "id": "hero", "kind": "dropdown", "class": "sk-select", "action": "skirmish.hero", "options": [] },
            { "id": "color", "kind": "dropdown", "class": "sk-select", "action": "skirmish.color", "options": [] }
          ]
        }
      ]
    }
  },
  "root": {
    "class": "sk",
    "children": [
      { "kind": "image", "class": "cover", "image": "menu-art" },
      { "class": "sk-shade" },
      {
        "class": "sk-shell",
        "children": [
          {
            "class": "sk-header",
            "children": [
              {
                "class": "sk-heading",
                "children": [
                  { "kind": "label", "class": "eyebrow", "text": "@ui.skirmish.under-the-canopy" },
                  { "kind": "label", "class": "sk-title", "text": "@ui.skirmish.skirmish" }
                ]
              },
              {
                "class": "rl-tools",
                "children": [
                  { "id": "replays", "kind": "button", "class": "sk-ghost", "text": "@ui.skirmish.replays", "action": "skirmish.replays" },
                  { "kind": "button", "class": "sk-ghost", "text": "@ui.skirmish.main-menu", "action": "skirmish.back" }
                ]
              }
            ]
          },
          {
            "class": "sk-layout",
            "children": [
              {
                "class": "sk-col",
                "children": [
                  { "kind": "label", "class": "sk-section", "text": "@ui.skirmish.battlefields" },
                  { "id": "maps", "class": "sk-maps", "repeat": "sk-map" }
                ]
              },
              {
                "class": "sk-col sk-col-mid",
                "children": [
                  {
                    "id": "preview", "class": "sk-preview",
                    "children": [
                      { "id": "image", "kind": "image", "class": "sk-preview-image" },
                      { "id": "empty", "kind": "label", "class": "sk-preview-empty", "text": "@ui.skirmish.preview-not-published", "visible": false },
                      { "id": "markers", "class": "fill", "style": { "pointer-events": "none" }, "repeat": "sk-marker" }
                    ]
                  },
                  { "kind": "label", "class": "sk-legend", "text": "@ui.skirmish.numbered-rings-mark-the-starting" },
                  { "id": "title", "kind": "label", "class": "sk-map-title" },
                  { "id": "meta", "kind": "label", "class": "sk-meta" },
                  { "id": "description", "kind": "label", "class": "sk-desc" }
                ]
              },
              {
                "class": "sk-col",
                "children": [
                  { "kind": "label", "class": "sk-section", "text": "@ui.skirmish.players" },
                  { "id": "players", "class": "sk-players", "repeat": "sk-player" },
                  { "kind": "label", "class": "sk-hint", "text": "@ui.skirmish.choose-your-starting-position-or" },
                  { "id": "status", "kind": "label", "class": "sk-status" },
                  { "id": "rules-caption", "kind": "label", "class": "sk-rules-caption", "text": "@ui.skirmish.victory" },
                  { "id": "rules", "kind": "label", "class": "sk-rules", "text": "@ui.skirmish.destroy-all-rival-buildings-the" }
                ]
              }
            ]
          },
          {
            "class": "sk-footer",
            "children": [
              { "id": "footnote", "kind": "label", "class": "sk-footnote", "text": "@ui.skirmish.local-match-all-map-positions" },
              { "id": "start", "kind": "button", "class": "sk-launch", "text": "@ui.skirmish.start-skirmish", "action": "skirmish.start" }
            ]
          }
        ]
      }
    ]
  }
}
