{
  "name": "canopy-matchhost",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Under the Canopy match server: lobby and lockstep relay (docs/server.md)",
  "scripts": {
    "start": "tsx src/index.ts",
