    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
